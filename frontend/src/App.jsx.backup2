        <AppointmentSection />

        <GallerySection />

        <TestimonialsFAQSection />

        <ContactSection />

        <Footer />

      </main>

      {/* ================= MOBILE ACTION BAR ================= */}
      <div className="fixed bottom-0 left-0 right-0 z-50 border-t border-[#123C2A]/10 bg-white/95 p-2 shadow-2xl backdrop-blur-xl lg:hidden">
        <div className="grid grid-cols-3 gap-2">

          <a
            href="tel:9822510456"
            className="flex flex-col items-center justify-center gap-1 rounded-xl py-2 text-[#123C2A]"
          >
            <Phone size={19} />
            <span className="text-[11px] font-semibold">Call</span>
          </a>

          <a
            href="https://wa.me/919822510456"
            target="_blank"
            rel="noreferrer"
            className="flex flex-col items-center justify-center gap-1 rounded-xl py-2 text-[#123C2A]"
          >
            <MessageCircle size={19} />
            <span className="text-[11px] font-semibold">WhatsApp</span>
          </a>

          <a
            href="#book-appointment"
            className="flex flex-col items-center justify-center gap-1 rounded-xl bg-[#123C2A] py-2 text-white"
          >
            <CalendarCheck size={19} />
            <span className="text-[11px] font-semibold">Book</span>
          </a>

        </div>
      </div>

    </div>
